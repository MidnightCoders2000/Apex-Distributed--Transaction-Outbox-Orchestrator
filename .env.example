DB_URL=jdbc:postgresql://<pooler-host>/<db>?sslmode=require&channel_binding=require
DB_USERNAME=<username>
DB_PASSWORD=<password>
DB_NAME=<db>

# Direct (non-pooler) connection — required for Debezium CDC, which needs
# logical replication that PgBouncer pooled connections don't support.
DIRECT_DB_HOST=<direct-host-without-pooler-suffix>

# Optional: defaults to 5432 if unset (used by infra/debezium/verify-mock-consumers.sh)
# DB_PORT=5432

# Optional: defaults to localhost:29092 if unset (payment-service/shipment-service)
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Optional: Epic B3 failure-injection overrides (defaults: rate=0.0, no triggers)
# PAYMENT_FAILURE_RATE=0.0
# PAYMENT_FAILURE_TRIGGER_ACCOUNT_IDS=
# SHIPMENT_FAILURE_RATE=0.0
# SHIPMENT_FAILURE_TRIGGER_ACCOUNT_IDS=
